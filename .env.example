# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# Spring Boot itself does not load `.env` files automatically. Export these
# as real environment variables before running the app, e.g.:
#   - IntelliJ: Run/Debug Configuration -> Environment variables
#   - shell:    set -a; source .env; set +a   (bash)  /  Get-Content .env | ... (PowerShell)
#
# Gmail SMTP credentials used by AsyncEmailServiceImpl for activation /
# password-reset / notification emails. MAIL_PASSWORD must be a Gmail
# "App Password" (Google Account -> Security -> App passwords), not the
# account's normal login password.
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# HMAC signing key for access/refresh JWTs (io.jsonwebtoken). Must be at
# least 32 bytes/characters long or the app fails to start (see JwtUtil /
# JwtConfig). Generate one locally, e.g.:
#   openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
